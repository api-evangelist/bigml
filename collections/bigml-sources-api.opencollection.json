                "description": "BigML API key."
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "name",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "data",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "remote",
                  "type": "text",
                  "value": ""
                }
              ]
            }

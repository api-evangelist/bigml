{
  "opencollection": "1.0.0",
  "info": {
    "name": "BigML REST Anomaly Detection Sources API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "username",
      "value": "{{username}}",
      "placement": "query"
    }
  },
  "items": [
    {

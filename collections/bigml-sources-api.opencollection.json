            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://bigml.io/andromeda/source",
            "params": [
              {
                "name": "username",
                "value": "",
                "type": "query",
                "description": "BigML username."
              },
              {
                "name": "api_key",
                "value": "",
                "type": "query",
                "description": "BigML API key."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of resources to return."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Index of the first resource to return."
              },
              {
                "name": "order_by",
                "value": "",
                "type": "query",
                "description": "Field to sort results by. Prefix with - for descending order."
              }
            ]
          },
          "docs": "List Sources"
